# Django Settings
SECRET_KEY=django-insecure-development-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# --- SQLite for default dev
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- PostgreSQL (uncomment and fill in if using docker-compose.dev.yml or docker-compose.yml)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=esg_scoring
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost        # use 'localhost' for docker-compose.dev.yml
# DB_HOST=db               # use 'db' for docker-compose.yml
# DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
